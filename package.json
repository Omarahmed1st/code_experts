{
  "name": "codelab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@fontsource/dejavu-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@vinext/cloudflare": "1.0.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.53.0",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "browsercc": "0.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pyodide": "314.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "scripts": {
    "predev": "node tools/copy-pyodide.mjs && node tools/copy-cpp-runtime.mjs",
    "dev": "vite dev",
    "prebuild": "node tools/copy-pyodide.mjs && node tools/copy-cpp-runtime.mjs",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "check:vinext": "vinext check",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "test": "npm run db:mirror && vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "npm run db:mirror && vitest run --project workers",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/0001_courses.sql && wrangler d1 execute DB --local --file seed/0002_content.sql && wrangler d1 execute DB --local --file seed/0003_exercises.sql && node --experimental-strip-types tools/seed-r2.ts",
    "admin:create": "node --experimental-strip-types tools/create-admin.ts",
    "db:mirror": "node -e \"require('fs').rmSync('.drizzle-mirror',{recursive:true,force:true})\" && drizzle-kit generate --name mirror",
    "measure:cpu": "node tools/measure-cpu.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "content:build": "node --experimental-strip-types tools/build-content.ts",
    "content:check": "node --experimental-strip-types tools/check-lesson-code.ts && node --experimental-strip-types tools/check-exercise-code.ts"
  }
}
