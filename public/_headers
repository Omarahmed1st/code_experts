# Cache rules for static files (Cloudflare Workers static assets read this file).
# The Pyodide folder name contains its version, so its files never change.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# The C++ compiler folder name contains its version too. Its .gz files are
# served as plain bytes: the worker unpacks them itself.
/cpp/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/runner/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
